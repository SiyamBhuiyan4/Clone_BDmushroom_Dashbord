# Gmail account the mail is sent from.
GMAIL_USER=aziel.help@gmail.com

# A Google *app password*, not the account password. Sixteen characters;
# the spaces Google shows are for reading and are stripped before use.
# Create one at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# The shared secret every caller must send as the `x-api-key` header.
# Generate one with:  openssl rand -hex 32
MAILER_API_KEY=

# What recipients see as the sender's name.
MAIL_FROM_NAME=BD Mushroom

# Stated lifetime of a sign-in code, in minutes. Must match the value the
# Convex backend enforces, or the email promises something untrue.
OTP_MINUTES=10

PORT=4000
